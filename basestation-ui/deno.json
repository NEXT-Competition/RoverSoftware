{
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-env server/main.ts",
    "desktop": "deno desktop dev server/main.ts",
    "bundle": "deno desktop build server/main.ts"
  },
  "imports": {
    "@std/http/file-server": "jsr:@std/http@^1.0.13/file-server"
  },
  "fmt": {
    "exclude": ["dist", "node_modules"]
  },
  "lint": {
    "exclude": ["dist", "node_modules"]
  },
  "desktop": {
    "name": "RoverSoftware Base Station",
    "entrypoint": "./server/main.ts",
    "icon": "./public/icon-512.png",
    "window": {
      "title": "RoverSoftware · base station",
      "width": 1280,
      "height": 820,
      "resizable": true
    }
  }
}
