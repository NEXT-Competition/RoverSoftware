[
  {
    "key": "route",
    "title": "Drive a GPS route",
    "blurb": "Loads a list of waypoints, hands them to the waypoint controller, and finishes when the last one is reached. This is the smallest complete autonomous run.",
    "needs": "Waypoints — paste “lat,lon” one per line into the first step.",
    "spec": {
      "id": "drive_route",
      "name": "Drive a GPS route",
      "start": "load",
      "on_estop": "abort",
      "states": [
        {
          "id": "load",
          "x": 40,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "on_enter": [
            {
              "do": "set_route",
              "waypoints": ""
            }
          ],
          "transitions": [
            {
              "when": "always",
              "to": "drive"
            }
          ]
        },
        {
          "id": "drive",
          "x": 300,
          "y": 120,
          "drive": {
            "mode": "waypoint"
          },
          "transitions": [
            {
              "when": "route_done",
              "to": "done"
            }
          ]
        },
        {
          "id": "done",
          "x": 560,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "terminal": true,
          "transitions": []
        }
      ]
    }
  },
  {
    "key": "find",
    "title": "Find and approach a target",
    "blurb": "Waits for the camera to see something, drives at it with object align, and stops at the standoff distance. Falls back to searching if the target is lost.",
    "spec": {
      "id": "find_target",
      "name": "Find and approach a target",
      "start": "search",
      "on_estop": "abort",
      "states": [
        {
          "id": "search",
          "x": 40,
          "y": 120,
          "drive": {
            "mode": "object_align"
          },
          "transitions": [
            {
              "when": "target_visible",
              "to": "approach"
            }
          ]
        },
        {
          "id": "approach",
          "x": 300,
          "y": 120,
          "drive": {
            "mode": "object_align"
          },
          "transitions": [
            {
              "when": "arrived",
              "to": "done"
            },
            {
              "when": "not",
              "of": [
                {
                  "when": "target_visible"
                }
              ],
              "for_seconds": 1.5,
              "to": "search"
            }
          ]
        },
        {
          "id": "done",
          "x": 560,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "terminal": true,
          "transitions": []
        }
      ]
    }
  },
  {
    "key": "laps",
    "title": "Repeat a step three times",
    "blurb": "The counter pattern. A step does its work, counts, and loops back until the count is reached — so “do this N times” is one box and a number, not the same box drawn N times.",
    "spec": {
      "id": "three_laps",
      "name": "Repeat a step three times",
      "start": "work",
      "on_estop": "abort",
      "states": [
        {
          "id": "work",
          "x": 40,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "on_enter": [
            {
              "do": "count",
              "name": "laps",
              "by": 1
            },
            {
              "do": "log",
              "message": "lap"
            }
          ],
          "transitions": [
            {
              "when": "counter",
              "name": "laps",
              "at_least": 3,
              "to": "done"
            },
            {
              "when": "elapsed",
              "seconds": 1,
              "to": "work"
            }
          ]
        },
        {
          "id": "done",
          "x": 300,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "terminal": true,
          "transitions": []
        }
      ]
    }
  },
  {
    "key": "waitgo",
    "title": "Wait for the operator, then go",
    "blurb": "Holds at the line until you press Send event, then runs. The starting gun for a match — everything else can be wired downstream of the “go” step.",
    "spec": {
      "id": "wait_then_go",
      "name": "Wait for the operator, then go",
      "start": "armed",
      "on_estop": "abort",
      "states": [
        {
          "id": "armed",
          "x": 40,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "transitions": [
            {
              "when": "event",
              "name": "go",
              "to": "run"
            }
          ]
        },
        {
          "id": "run",
          "x": 300,
          "y": 120,
          "drive": {
            "mode": "teleop"
          },
          "transitions": [
            {
              "when": "elapsed",
              "seconds": 30,
              "to": "done"
            }
          ]
        },
        {
          "id": "done",
          "x": 560,
          "y": 120,
          "drive": {
            "mode": "stop"
          },
          "terminal": true,
          "transitions": []
        }
      ]
    }
  }
]
