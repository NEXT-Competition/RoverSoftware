# RoverSoftware base-station configuration.
# After editing: sudo systemctl restart roversoftware-basestation
#
# dpkg conffile: your edits are preserved across package upgrades.

# XBee radio on the base-station Pi (USB adapter). Must match the robots' baud.
RS_XBEE_PORT=/dev/ttyUSB0
RS_XBEE_BAUD=57600

# Web server bind. The kiosk browser connects to localhost, so 127.0.0.1 is
# fine; set 0.0.0.0 if you also want to reach it from a laptop on the network.
RS_WEB_HOST=127.0.0.1
RS_WEB_PORT=8000

# Set to 1 to run the built-in simulator (fake robots) instead of a real radio.
# Handy for testing the kiosk with no XBee attached.
RS_SIM=0

# Set to 1 to disable the gamepad reader (pure touch-screen base station).
RS_NO_CONTROLLER=0

# Send/refresh-rate tuning.
RS_DRIVE_HZ=30
RS_UI_HZ=30

# Map tiles — offline-capable, self-filling cache (MapTiler outdoor/topo).
# The browser loads tiles from THIS base station (/tiles/...), served from a local
# cache. On a cache miss the server fetches the tile from MapTiler and stores it,
# so the cache fills itself transparently as you pan the map online — no manual
# step, nothing for the operator to do. Once an area is cached it works with no
# internet. Set RS_TILES_OFFLINE=1 to stop fetching online entirely (serve only
# what's already cached). Style: swap outdoor-v2 for streets-v2 etc.
RS_TILES=/tiles/{z}/{x}/{y}.png
RS_TILES_MBTILES=/var/lib/roversoftware/tiles.mbtiles
RS_TILES_UPSTREAM=https://api.maptiler.com/maps/outdoor-v2/{z}/{x}/{y}.png?key=q0itBTmKuDG8F5NjmQZ0
RS_TILES_OFFLINE=0
