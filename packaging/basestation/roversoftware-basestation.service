[Unit]
Description=RoverSoftware base-station dashboard server
After=network.target

[Service]
Type=simple
# Per-instance settings (radio port/baud, web port, sim mode). '-' = optional.
EnvironmentFile=-/etc/roversoftware/basestation.env
WorkingDirectory=/opt/roversoftware-basestation
ExecStart=/usr/bin/python3 /opt/roversoftware-basestation/run_basestation.py
Restart=on-failure
RestartSec=3

# Root for simple serial (XBee on USB) + gamepad access; the server is headless.
# The touch kiosk browser runs separately from the desktop autostart entry.
User=root

[Install]
WantedBy=multi-user.target
