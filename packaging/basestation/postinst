#!/bin/sh
# Post-install: register and (re)start the dashboard server service.
set -e

case "$1" in
    configure)
        # Writable home for the offline map tile cache (RS_TILES_MBTILES) and
        # the dashboard-set settings file (RS_BASE_SETTINGS).
        mkdir -p /var/lib/roversoftware || true
        systemctl daemon-reload || true
        systemctl enable roversoftware-basestation.service || true
        systemctl restart roversoftware-basestation.service || true
        # Deno touch-UI front door (best-effort: needs deno on PATH; if it's
        # not installed yet the unit just fails and can be started later).
        systemctl enable roversoftware-ui.service || true
        systemctl restart roversoftware-ui.service || true
        ;;
esac

exit 0
