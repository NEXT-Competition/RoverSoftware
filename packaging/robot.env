# Per-robot configuration for the roversoftware-robot service.
# After editing: sudo systemctl restart roversoftware-robot
#
# This is a dpkg conffile: your edits are preserved across package upgrades.

# Unique id for this robot on the shared XBee channel (the base station
# addresses commands to this id). Set a different value on each robot.
RS_ROBOT_ID=rover1

# XBee serial port and baud rate.
#   /dev/serial0  -> Pi GPIO UART (typical for an XBee on the header)
#   /dev/ttyUSB0  -> XBee on a USB adapter
RS_XBEE_PORT=/dev/ttyUSB0
RS_XBEE_BAUD=115200

# Bulk transfers (config snapshots, layouts, routine documents) over WiFi. A
# snapshot is ~2.9 KB — roughly half a second of exclusive airtime on a channel
# shared with every robot, and it is telemetry that gets dropped while it goes
# out. So that traffic does not use the radio at all: set this to the base
# station's hostname or IP (the same machine RS_FPV_HOST points at) and it rides
# TCP instead.
#
# Blank or unreachable means this robot cannot be configured from the base
# station until it is on WiFi — the dashboard says so. Driving, telemetry and
# the e-stop are unaffected either way; they never leave the radio.
#
# You do NOT have to edit this file to change it. This is the one setting the
# base station can send over the radio (Settings -> Robot -> comms.base_host),
# and it applies immediately — which is the point, since a rover pointed at the
# wrong base station has no WiFi path to be told the right one over.
RS_BASE_HOST=
RS_BASE_PORT=5006

# Mode to start in: teleop | object_align | shooter_align | waypoint | routine
RS_START_MODE=teleop

# Control loop rate (Hz)
RS_LOOP_HZ=50

# GPS (Adafruit Ultimate GPS — MTK3339/PA1616D breakout, FeatherWing or HAT) for
# waypoint autonomy. Plain NMEA on the Pi GPIO UART; install the driver:
#     pip install adafruit-circuitpython-gps
# Keep this port distinct from RS_XBEE_PORT above. /dev/ttyAMA0 requires the
# serial console disabled and the header UART enabled (Bluetooth owns the good
# PL011 UART by default) — run `just uart` from the dev machine, then reboot.
# Equivalent by hand: sudo raspi-config -> Interface Options -> Serial Port
# (login shell: No, hardware: Yes), plus dtoverlay=disable-bt in config.txt.
# Watch a live fix (satellites, HDOP, track angle) with tools/gps_monitor.py.
RS_GPS_ENABLED=1
RS_GPS_PORT=/dev/ttyAMA0
RS_GPS_BAUD=9600
# Milliseconds between fixes (PMTK220): 1000 = 1 Hz, 200 = 5 Hz. A faster rate
# means a fresher heading, but GGA+RMC+VTG must still fit the link — below about
# 200 ms they don't at 9600 baud, and truncated sentences look like "no fix".
RS_GPS_RATE_MS=1000

# Which sensor answers "which way am I facing":
#   auto - the IMU when it's calibrated, else the GPS track angle (recommended)
#   gps  - the GPS TRACK ANGLE only. A true-North heading with no compass, no
#          calibration and no declination correction — but it's the direction the
#          rover is TRAVELLING, so it's noise at a standstill and can't see a
#          pivot in place. Fine for a rover that navigates by driving; use it if
#          you have no IMU (or don't trust the one you have).
#   imu  - the IMU only; heading stays unknown until it calibrates.
RS_HEADING_SOURCE=auto

# BNO085 IMU: absolute heading (valid at standstill) for pose estimation and the
# waypoint angle loop. On the Pi I2C bus (shared with the Fusion HAT), default
# address 0x4A (0x4B if the DI/AD0 pin is pulled high).
#
# Wiring: unlike the BNO055 it replaces, the BNO08x speaks SHTP and does NOT abuse
# I2C clock stretching, so it runs at the Pi's normal bus speed — the old
# dtparam=i2c_arm_baudrate=10000 workaround is NOT needed and should be removed if
# you set it for the previous sensor. Strap PS0/PS1 for I2C mode. Verify with
# tools/imu_selftest.py. Then install the driver:
#     pip install adafruit-circuitpython-bno08x
#
# RS_IMU_OFFSET rotates the sensor yaw to align with North (0=North, CW+); tune it
# with tools/imu_monitor.py during bring-up. Set RS_IMU_ENABLED=0 to fall back to
# the GPS track angle (no heading at standstill; see RS_HEADING_SOURCE above).
#
# Calibration persists on the chip: the BNO08x saves its own calibration to
# on-chip flash (no file to manage, unlike the BNO055). With RS_IMU_SAVE_CALIB=1
# the driver runs dynamic calibration and writes it to flash the first time the
# level reaches 3. To (re)calibrate: run  python3 tools/imu_monitor.py  and spin
# the rover in figure-8s until the calibration level hits 3 (it saves itself), then
# restart the service. Set RS_IMU_SAVE_CALIB=0 to disable the auto-save.
RS_IMU_ENABLED=1
RS_IMU_ADDRESS=0x4A
RS_IMU_OFFSET=0
RS_IMU_SAVE_CALIB=1

# --- Vision: object detection -> object_align autonomy ---
#
# TWO INTERCHANGEABLE BACKENDS. object_align cannot tell them apart; pick one.
#
#   imx500        Raspberry Pi AI Camera (Sony IMX500). The network runs INSIDE
#                 the sensor and boxes arrive as frame metadata — near-zero Pi
#                 CPU, and every model gives real sized boxes (so approach and
#                 standoff always work). Needs that specific camera.
#   edge_impulse  A compiled .eim run on the Pi's CPU. Works with any camera,
#                 costs a core and 50-200ms per frame.
#
# auto = imx500 if an AI Camera is attached AND its .rpk exists, else
# edge_impulse. Deliberately conservative: an existing rover keeps running the
# model it was set up with until you say otherwise. Set to `auto` if you want
# that fallback; the explicit `imx500` below means a rover with no network
# installed fails loudly instead of quietly running a different model.
RS_VISION_BACKEND=imx500

# --- imx500 backend ---
# Install:
#     sudo apt install python3-picamera2 imx500-all
# `imx500-all` drops the Sony model zoo in /usr/share/imx500-models/. Unlike the
# .eim, the .rpk is DATA the sensor loads — no chmod +x needed. The default below
# is the general-purpose COCO detector (80 classes: person, car, bottle, ...);
# swap in your own export if you trained one.
RS_VISION_IMX500_MODEL=/var/lib/roversoftware/network.rpk
# Class names, one per line. Empty = the labels embedded in the .rpk, which is
# right for every model-zoo network. Only a custom export packaged without them
# needs this.
RS_VISION_IMX500_LABELS=/var/lib/roversoftware/labels.txt
# NMS overlap threshold (nanodet networks only — the `_pp` ones do NMS
# on-sensor) and the cap on boxes decoded per frame.
RS_VISION_IMX500_IOU=0.65
RS_VISION_IMX500_MAX_DET=10
#
# Bring-up on the AI Camera:
#   1. tools/detector_selftest.py --backend imx500 — checks the ribbon, the
#      .rpk, the labels, and prints live detections. First run is SLOW: the
#      network crosses to the sensor (tens of seconds). So is the first boot of
#      the service; that's the sensor, not a hang.
#   2. --save a frame: do the boxes land on the objects?
#   3. Park at your stop distance, read the printed `size` -> RS_VISION_STANDOFF.
#   4. Set RS_VISION_HFOV to the camera's REAL horizontal FOV (~66 for the stock
#      lens). There is no Edge Impulse crop on this path.
#   5. Rover ON BLOCKS, RS_START_MODE=object_align, watch the track outputs.
# RS_CAMERA_DEVICE is set to imx500 for you when this backend is selected.

# --- edge_impulse backend ---
# Install (Pi only; edge_impulse_linux is Linux-only and runs a compiled model):
#     pip install edge_impulse_linux
# plus ONE capture stack:
#     sudo apt install python3-picamera2   # Pi Camera (CSI ribbon)
#     pip install opencv-python            # USB webcam / V4L2
#
# Get a model. The .eim is a BINARY that Edge Impulse EXECUTES — it must be
# chmod +x, and forgetting that is the most common first-run failure:
#     edge-impulse-linux-runner --download model.eim
#     chmod +x model.eim && sudo mv model.eim /var/lib/roversoftware/model.eim
# Note `just sync` deploys code only, so the model is a manual/.deb step (same
# caveat as this conffile).
#
# *** Export a YOLO-style (object_detection) model, NOT FOMO. ***
# FOMO reports centroids with fixed cell-sized boxes, so object size is
# unavailable: object_align will turn to face the target but will never approach
# or stop at a standoff. The detector detects this and says so on startup.
#
# Bring-up, in order (tools/detector_selftest.py does the first three):
#   1. Check deps, chmod, labels, model_type, and fps.
#   2. --save a frame: are the colours right (red/blue not swapped) and is the
#      target inside Edge Impulse's center-crop?
#   3. Park at your stop distance, read the printed `size` -> RS_VISION_STANDOFF.
#   4. Rover ON BLOCKS, RS_START_MODE=object_align, watch the track outputs.
RS_VISION_MODEL=/var/lib/roversoftware/model.eim

# --- shared by both backends ---
RS_VISION_ENABLED=1
# Object label to track. Empty = whatever the model reports (must match a label
# from tools/detector_selftest.py exactly, or nothing will ever match).
RS_VISION_LABEL=
RS_VISION_CONF=0.6
# Rate cap. On edge_impulse this is the INFERENCE rate and it eats a core, so
# keep it well under the control loop rate and watch the journal for slow-tick
# warnings. On imx500 the sensor infers at its own rate regardless; this only
# caps how often the Pi decodes the result (sub-millisecond), so it buys back
# almost nothing and can go higher.
RS_VISION_FPS=10
# Stop when the box height reaches this fraction of the frame height (of the
# model input height, on edge_impulse). CALIBRATE THIS — it is not guessable,
# and the two backends normalize it against different rectangles, so recalibrate
# if you switch.
RS_VISION_STANDOFF=0.45
# Horizontal FOV in degrees that the normalized error units span. This scales
# the IMU yaw-rate into those units; wrong values show up as steering
# oscillation. ITS CORRECT VALUE DEPENDS ON THE BACKEND:
#   edge_impulse — the EFFECTIVE FOV after EI's center-crop, not the camera's
#                  spec (the crop throws away ~25% of the width at 640x480). 50.
#   imx500       — the camera's REAL horizontal FOV (~66 for the AI Camera's
#                  stock lens); boxes map back to the full frame, nothing is cropped.
# 66 matches RS_VISION_BACKEND=imx500 above — drop it back to 50 if you switch
# to edge_impulse, or the steering will oscillate.
RS_VISION_HFOV=66
# Slow rotate to reacquire a lost target. 0 disables (robot just stops).
RS_VISION_SEARCH_SPEED=0.25

# Camera. device: auto | imx500 | picamera2 | /dev/videoN | index. Shared by
# object detection and the FPV feed below (one process can't open the device
# twice). OpenCV (python3-opencv) is required for a USB/V4L2 camera and for JPEG
# encoding.
#
# "auto" never picks imx500 — loading the sensor's network costs tens of seconds
# on a cold boot, so it only happens when something wants on-sensor inference.
# Selecting RS_VISION_BACKEND=imx500 sets this to imx500 for you. Set it here by
# hand only to run an AI Camera as a plain camera (FPV with no detection).
RS_CAMERA_ENABLED=1
RS_CAMERA_DEVICE=auto
RS_CAMERA_WIDTH=640
RS_CAMERA_HEIGHT=480
RS_CAMERA_FPS=15

# --- FPV: first-person live video to the base station ---
# Streams JPEG over UDP on the shared WiFi/LAN (the XBee radio can't carry
# video), so it only works within WiFi range and is OFF by default. Turn it on
# and point RS_FPV_HOST at the machine running the base station; the feed then
# shows up in the dashboard's FPV panel for this robot.
RS_FPV_ENABLED=0
RS_FPV_HOST=Yojans-MacBook-Pro.local
RS_FPV_PORT=5005
RS_FPV_FPS=15
# JPEG quality 1-100; lower = less bandwidth. Comment kept on its own line: a
# shell sourcing this file strips a trailing #comment, systemd's EnvironmentFile
# parser is not guaranteed to, and run_robot.py does int() on the value.
RS_FPV_QUALITY=60

# ---------------------------------------------------------------------------
# Shooter (shooter_align mode)
# ---------------------------------------------------------------------------
# A servo-actuated launcher on its own PWM channel. shooter_align is object_align
# plus a trigger: it aligns and approaches exactly as object_align does, then
# holds still and fires once the aim has SETTLED.
#
# Off by default — a chassis without a launcher should not be driving an unused
# channel. Enabling this on a build that has no shooter is harmless but pointless.
#
# *** Bring-up, in order. Do not skip step 1. ***
#   1. UNLOADED, rover on blocks. RS_SHOOTER_ENABLED=1, then use the base
#      station's Arm + Fire buttons to watch the mechanism cycle with nothing
#      in it.
#   2. tools/servo_sweep.py on RS_SHOOTER_CHANNEL to find the rest and fire
#      angles. Wrong angles stall the servo against a mechanical stop — it will
#      get hot and draw current until you notice.
#   3. Still unloaded, RS_START_MODE=shooter_align: confirm it aligns, stops,
#      and trips only while pointed at the target.
#   4. Only then load it, and only with the muzzle pointed somewhere safe.
RS_SHOOTER_ENABLED=0
# On the stock layout channels 0 and 1 are the drive ESCs. This is now checked
# rather than trusted: a layout that puts two actuators on one PWM channel is
# refused, and the drivetrain wins the tie (see RS_LAYOUT_FILE below).
RS_SHOOTER_CHANNEL=2
# Servo angles for the home and fire positions (step 2 above).
#
# *** If this channel drives a MOTOR through an ESC — a dumper, a roller, a
# spinner — rather than a positional servo, RS_SHOOTER_REST must be NEUTRAL (5
# on the Fusion HAT). *** The mechanism sits at the rest angle whenever it is
# idle, and neutral is the pulse that ARMS an ESC: one that has never been held
# there ignores everything sent afterwards. Leave rest at a servo geometry value
# like -30 and the journal logs a healthy "fire #1" while nothing moves and the
# button looks dead. A positional servo has nothing to arm and can rest anywhere.
RS_SHOOTER_REST=-30
RS_SHOOTER_FIRE=30
# How long to HOLD the fire angle, then settle at rest before another shot may
# start. Too short and the servo never reaches the angle; too long and it stalls.
RS_SHOOTER_FIRE_S=0.35
RS_SHOOTER_RETRACT_S=0.35
# Hold the alignment this long before firing. THE key accuracy/safety knob: the
# detector is noisy, and one centered frame is not evidence the robot is actually
# pointed at anything. Raise it if it ever shoots at a false positive.
RS_SHOOTER_DWELL=0.5
# Minimum seconds between shots.
RS_SHOOTER_COOLDOWN=2.0
# Magazine capacity; 0 = unlimited.
RS_SHOOTER_MAX_SHOTS=0
# Require an explicit Arm from the base station before any shot. LEAVE THIS AT 1.
# Arming is dropped on e-stop and on leaving the mode, so it can never be
# inherited from a previous run — setting this to 0 throws that away and the
# robot will fire the moment it sees a target.
RS_SHOOTER_REQUIRE_ARM=1
# Also require the standoff distance, not just the bearing. Automatically skipped
# on FOMO models, which cannot measure size (see the vision section).
RS_SHOOTER_REQUIRE_ARRIVED=1

# Where values tuned from the base station's Settings page (PID gains, speeds,
# drive limits) are saved on this robot. Applied AFTER everything above: they
# are the operator's most recent deliberate decision, and the paths they can
# reach are disjoint from the wiring settings in this file — no variable here
# names a PID gain. Delete the file to return to the values above.
RS_TUNING_FILE=/var/lib/roversoftware/tuning.json

# ---------------------------------------------------------------------------
# HARDWARE LAYOUT AND ROUTINES
# ---------------------------------------------------------------------------
#
# The variables above describe a robot with two drive ESCs and an optional
# launcher, which is what a stock build is. A build with anything else — one
# motor and a steering servo, three intake motors, a second launcher — declares
# it in a LAYOUT, written from the base station's Hardware tab.
#
# Structure lives apart from the tuning file above because the two are edited at
# completely different cadences and fail differently: a bad gain makes the robot
# drive badly, a bad layout stops it driving. Precedence is
#
#     compiled-in defaults  ->  this file  ->  layout.json  ->  tuning.json
#
# A layout is validated on arrival and only takes effect on the NEXT START.
# Actuators are built at start-up, and rebuilding them mid-drive would leave an
# ESC holding an undefined pulse. Delete the file to go back to the stock
# two-motor tank drive; a corrupt one is ignored, not fatal.
RS_LAYOUT_FILE=/var/lib/roversoftware/layout.json

# State machines authored in the base station's Routines tab. Unlike a layout,
# these ARE hot-swappable — they are data the engine reads, not hardware a
# constructor owns — so a saved routine takes effect immediately.
RS_ROUTINES_FILE=/var/lib/roversoftware/routines.json

# Whether a routine may arm the launcher. LEAVE THIS AT 0 unless you have a
# specific reason: it is the one action a drawn program can take that makes
# something physically launch. Even at 1, arming is only accepted inside a state
# that drives with shooter_align — which is where dwell, cooldown and the
# magazine are enforced — and is dropped on every state exit, mode exit and
# e-stop. Turning it back to 0 stops a routine that is already running.
RS_ROUTINE_ALLOW_ARM=0

# Any state that does not set its own limit inherits this one. A state machine
# that can never be left is a robot that runs until somebody hits the e-stop, so
# a routine with no terminal state, no routine timeout and every per-state limit
# switched off is refused outright.
RS_ROUTINE_STATE_TIMEOUT=60
