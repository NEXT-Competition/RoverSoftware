# Per-robot configuration for the roversoftware-robot service.
# After editing: sudo systemctl restart roversoftware-robot
#
# This is a dpkg conffile: your edits are preserved across package upgrades.

# Unique id for this robot on the shared XBee channel (the base station
# addresses commands to this id). Set a different value on each robot.
RS_ROBOT_ID=rover1

# XBee serial port and baud rate.
#   /dev/serial0  -> Pi GPIO UART (typical for an XBee on the header)
#   /dev/ttyUSB0  -> XBee on a USB adapter
RS_XBEE_PORT=/dev/ttyUSB0
RS_XBEE_BAUD=57600

# Mode to start in: teleop | object_align | waypoint
RS_START_MODE=teleop

# Control loop rate (Hz)
RS_LOOP_HZ=50

# GPS (u-blox NEO-6M) for waypoint autonomy. Plain NMEA on the Pi GPIO UART.
# Keep this port distinct from RS_XBEE_PORT above. Using /dev/ttyAMA0 requires
# the serial console disabled + UART enabled: sudo raspi-config -> Interface
# Options -> Serial Port (login shell: No, hardware: Yes), then reboot.
RS_GPS_ENABLED=1
RS_GPS_PORT=/dev/ttyAMA0
RS_GPS_BAUD=9600

# BNO055 IMU: absolute heading (valid at standstill) for pose estimation and the
# waypoint angle loop. On the Pi I2C bus (shared with the Fusion HAT), default
# address 0x28 (0x29 if the ADR pin is pulled high).
#
# REQUIRED wiring step: the BNO055 clock-stretches on the Pi's hardware I2C, which
# corrupts reads (garbage accel/temperature). 100 kHz (the Pi DEFAULT) is not slow
# enough — add this to /boot/firmware/config.txt (older Pi OS: /boot/config.txt)
# and reboot:
#     dtparam=i2c_arm_baudrate=10000
# To keep full bus speed instead, use a software I2C bus (dtoverlay=i2c-gpio),
# which handles clock stretching correctly. Verify either way with
# tools/imu_selftest.py. Then install the driver:
#     pip install adafruit-circuitpython-bno055
#
# RS_IMU_OFFSET rotates the sensor yaw to align with North (0=North, CW+); tune it
# with tools/imu_monitor.py during bring-up. Set RS_IMU_ENABLED=0 to fall back to
# GPS-course heading (no compass at standstill).
#
# Calibration persists: the BNO055 forgets its calibration on power-off, so the
# driver saves the offsets once sys/mag reach 3 and reloads them on boot. To
# (re)calibrate: stop the service, run  sudo python3 tools/imu_monitor.py  and
# spin the rover until sys/mag hit 3 (it auto-saves to RS_IMU_CALIB), then start
# the service. Set RS_IMU_CALIB='' to disable persistence.
RS_IMU_ENABLED=1
RS_IMU_ADDRESS=0x28
RS_IMU_OFFSET=0
RS_IMU_CALIB=/var/lib/roversoftware/bno055_calibration.json

# --- Vision: Edge Impulse object detection -> object_align autonomy ---
#
# Install (Pi only; edge_impulse_linux is Linux-only and runs a compiled model):
#     pip install edge_impulse_linux
# plus ONE capture stack:
#     sudo apt install python3-picamera2   # Pi Camera (CSI ribbon)
#     pip install opencv-python            # USB webcam / V4L2
#
# Get a model. The .eim is a BINARY that Edge Impulse EXECUTES — it must be
# chmod +x, and forgetting that is the most common first-run failure:
#     edge-impulse-linux-runner --download model.eim
#     chmod +x model.eim && sudo mv model.eim /var/lib/roversoftware/model.eim
# Note `just sync` deploys code only, so the model is a manual/.deb step (same
# caveat as this conffile).
#
# *** Export a YOLO-style (object_detection) model, NOT FOMO. ***
# FOMO reports centroids with fixed cell-sized boxes, so object size is
# unavailable: object_align will turn to face the target but will never approach
# or stop at a standoff. The detector detects this and says so on startup.
#
# Bring-up, in order (tools/detector_selftest.py does the first three):
#   1. Check deps, chmod, labels, model_type, and fps.
#   2. --save a frame: are the colours right (red/blue not swapped) and is the
#      target inside Edge Impulse's center-crop?
#   3. Park at your stop distance, read the printed `size` -> RS_VISION_STANDOFF.
#   4. Rover ON BLOCKS, RS_START_MODE=object_align, watch the track outputs.
RS_VISION_ENABLED=1
RS_VISION_MODEL=/var/lib/roversoftware/model.eim
# Object label to track. Empty = whatever the model reports (must match a label
# from tools/detector_selftest.py exactly, or nothing will ever match).
RS_VISION_LABEL=
RS_VISION_CONF=0.6
# Inference rate cap. Inference eats a core; keep this well under the control
# loop rate and watch the journal for slow-tick warnings during bring-up.
RS_VISION_FPS=10
# Stop when the box height reaches this fraction of the model input height.
# CALIBRATE THIS (step 3 above) — it is not guessable.
RS_VISION_STANDOFF=0.45
# EFFECTIVE horizontal FOV in degrees, AFTER Edge Impulse's center-crop — not the
# camera's spec (the crop throws away ~25% of the width at 640x480). This scales
# the IMU yaw-rate into the controller's normalized error units; wrong values
# show up as steering oscillation.
RS_VISION_HFOV=50
# Slow rotate to reacquire a lost target. 0 disables (robot just stops).
RS_VISION_SEARCH_SPEED=0.25

# Camera. device: auto | picamera2 | /dev/videoN | index. Shared by object
# detection and the FPV feed below (one process can't open the device twice).
# OpenCV (python3-opencv) is required for a USB/V4L2 camera and for JPEG encoding.
RS_CAMERA_ENABLED=1
RS_CAMERA_DEVICE=auto
RS_CAMERA_WIDTH=640
RS_CAMERA_HEIGHT=480
RS_CAMERA_FPS=15

# --- FPV: first-person live video to the base station ---
# Streams JPEG over UDP on the shared WiFi/LAN (the XBee radio can't carry
# video), so it only works within WiFi range and is OFF by default. Turn it on
# and point RS_FPV_HOST at the machine running the base station; the feed then
# shows up in the dashboard's FPV panel for this robot.
RS_FPV_ENABLED=0
RS_FPV_HOST=base-station.local
RS_FPV_PORT=5005
RS_FPV_FPS=15
RS_FPV_QUALITY=60       # JPEG quality 1-100; lower = less bandwidth
