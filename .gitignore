# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# model/ itself is NOT ignored — the .lite exports are tracked deliberately
# (438a6d7). Only the two things under it that must never be committed are:
#
# The training set. 2.5 GB of phone photos, and nothing ignores it by default,
# so a `git add -A` in a clean checkout will happily try to stage the lot.
# Rebuild the Ultralytics-readable staging copy with:
#   uv run tools/prepare_yolo_dataset.py --src model/data --out build/dataset
model/data/
# Generated by `YOLO.export(format="imx")` — reproducible, and the ONNX inside
# is ~11 MB. tools/imx500_export_yolo.py copies what matters to build/.
model/*_imx_model/
# Ultralytics checkpoints. Left untracked rather than ignored-forever is a real
# choice; 5 MB is committable if you want best.pt in git, just drop this line.
model/*.pt

# Stray lockfile from running npm at the repo root; the UI's real one lives in
# basestation-ui/ and is tracked. Anchored so it can't match that one.
/package-lock.json

# uv's lockfile. Untracked on purpose (fcf2878): it is a 5k-line generated file
# that every branch rewrites, git cannot merge it meaningfully, and a
# conflict-markered resolution gets committed silently — `uv run` then dies with
# a TOML parse error for everyone. The trade is that `uv sync` re-resolves
# instead of reproducing exact pins; pyproject.toml holds the constraints that
# actually matter. Re-track it (and resolve conflicts by regenerating, never by
# hand-editing) if you ever need byte-identical envs across machines.
/uv.lock

# Agent scratch space. The worktrees are live git checkouts; staging them turns
# each one into a gitlink pointing at a commit no clone can resolve.
/.claude/worktrees/
/.claude/settings.local.json

# Knowledge-graph tool output: caches and generated reports, regenerable.
/graphify-out/
